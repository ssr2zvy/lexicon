# Generic container file (works with Docker or Podman) that installs a
# pre-built Lexicon bundle tar.xz and keeps running so you can exec into it.
#
# BUNDLE_TAR must be a path *relative to the build context* pointing at a
# lexicon-bundle-*.tar.xz produced by automation/build_bundle_mza/mza, e.g.:
#
#   podman build -f containerization/lexicon-container/Containerfile \
#     --build-arg BUNDLE_TAR=artifacts/lexicon_bundle/custom/cargo-bundler-v0.1.0/0.1.0-LOCALSNAPSHOT/x86_64-unknown-linux-musl/lexicon-bundle-0.1.0-LOCALSNAPSHOT-x86_64-unknown-linux-musl.tar.xz \
#     -t lexicon-local-image .
#
# The build context must be the repo root (trailing `.`) so that path resolves.
FROM debian:bookworm-slim

ARG BUNDLE_TAR

RUN test -n "$BUNDLE_TAR" || { echo "BUNDLE_TAR build-arg is required: a path (relative to the build context) to a lexicon-bundle-*.tar.xz" >&2; exit 1; }

RUN apt-get update \
    && apt-get install -y --no-install-recommends xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY ${BUNDLE_TAR} /tmp/lexicon-bundle.tar.xz

# The archive contains a single top-level lexicon-bundle-<version>/ directory
# (not a flat lexicon-bundle binary), so extract then locate it by name.
# --install bypasses the interactive menu entirely, so this never blocks on stdin during the build.
RUN mkdir -p /opt/lexicon-bundle \
    && tar -xJf /tmp/lexicon-bundle.tar.xz -C /opt/lexicon-bundle \
    && rm /tmp/lexicon-bundle.tar.xz \
    && BUNDLE_DIR="$(find /opt/lexicon-bundle -mindepth 1 -maxdepth 1 -type d | head -n 1)" \
    && chmod +x "$BUNDLE_DIR/lexicon-bundle" \
    && "$BUNDLE_DIR/lexicon-bundle" --install

COPY containerization/lexicon-container/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
