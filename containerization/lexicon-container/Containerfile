# Generic container file (Docker or Podman) for the Lexicon runtime image.
#
# This Containerfile is INTENTIONALLY INERT under the current milestone.
# Per current.md §11 MZA-02 the produced target installer is the *only*
# authoritative install surface; the installer API MZA exposes is the
# blocker recorded in §3. Until MZA publishes and pins a Protocol 1
# installer API that owns install / upgrade / uninstall / command
# registration / platform integration, this container cannot invoke a
# real installer without inventing one — which the audit explicitly
# forbids.
#
# Once MZA's accepted installer API exists, this file will:
#
#   1. accept INSTALLER_PATH as a build arg pointing at the artifact the
#      pinned `automation/build_bundle_mza/build_release.sh` produces,
#   2. COPY that artifact in, and
#   3. run it with the *exact upstream install argument and binary
#      name* — never reconstructing installation via shell copies.
#
# Concretely (placeholder, not yet pinned):

# FROM debian:bookworm-slim
#
# ARG INSTALLER_PATH
#
# RUN test -n "$INSTALLER_PATH" || { echo "INSTALLER_PATH build-arg is required: a path (relative to the build context) to the MZA-produced installer binary." >&2; exit 1; }
#
# RUN apt-get update \
#     && apt-get install -y --no-install-recommends ca-certificates \
#     && rm -rf /var/lib/apt/lists/*
#
# COPY ${INSTALLER_PATH} /tmp/lexicon-installer
# RUN chmod +x /tmp/lexicon-installer \
#     && /tmp/lexicon-installer --install
#
# COPY containerization/lexicon-container/entrypoint.sh /usr/local/bin/entrypoint.sh
# RUN chmod +x /usr/local/bin/entrypoint.sh
#
# ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Marker comment export so test containers that scan the bundle configuration
# can detect the deferred state.
# lexicon-container/Containerfile status: blocked-on-mza-installer-api
