# Generic container definition for Docker or Podman.
# Build from the repository root:
#   docker build -f containerization/test-container/Containerfile -t lexicon-local .
#   podman build -f containerization/test-container/Containerfile -t lexicon-local .
#
# Run long-lived workspace container with the repo mounted at runtime:
#   docker run -d --name lexicon-local -v "$PWD":/lexicon --workdir /lexicon lexicon-local
#   docker exec -it lexicon-local bash
#
# Run a one-off build inside the running container:
#   docker exec -it lexicon-local bash -lc 'cd /lexicon && bash automation/build_bundle_install/build_bundle_install.sh skip'

FROM docker.io/library/rust:1-slim-bookworm

ENV PATH="/usr/local/cargo/bin:${PATH}"
# Login shells (bash -l) re-source /etc/profile and would otherwise drop the ENV PATH above.
RUN echo 'export PATH="/usr/local/cargo/bin:$PATH"' > /etc/profile.d/cargo-path.sh

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash curl xz-utils tar ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

ARG ZIG_VERSION=0.13.0
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz \
    && tar -xf /tmp/zig.tar.xz -C /usr/local \
    && ln -s "/usr/local/zig-linux-x86_64-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz

RUN rustup target add x86_64-unknown-linux-musl \
    && cargo install cargo-zigbuild

WORKDIR /lexicon
# The repository is mounted into /lexicon at runtime. This directory is created in the image
# so the runtime bind mount can overlay cleanly without rootless overlay mount issues.
RUN mkdir -p /lexicon

COPY containerization/test-container/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
